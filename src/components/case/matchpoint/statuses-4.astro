---
import PublicSvg from '../../common/PublicSvg.astro';

type Lang = 'ru' | 'en';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props as Props;
const src = `/assets/matchpoint/schemas/statuses.${lang}.svg`;
const alt =
  lang === 'en'
    ? 'Status system for confidence, severity, vendor review, exception type, resolution, attribution, and detection'
    : 'Система статусов для уверенности, критичности, проверки поставщика, типа исключения, решения, атрибуции и способа обнаружения';
---

<PublicSvg src={src} alt={alt} fit="container" className="matchpoint-statuses" />

---
// «Разбор интерфейса» (guided walkthrough) — порт прототипа v11 на стек проекта.
// Explore: hover по зоне → мгновенная рамка + peek-карточка (последовательная
// смена без наложения). Guided (клик по зоне / кнопке): модальный разбор с
// blur-затемнением, резкой clip-path копией активной зоны, счётчиком шага и
// фиксированной панелью Назад/Далее/закрыть.
//
// Зоны приходят пропом (typed Zone[]) — не хардкодятся в разметке. Координаты —
// проценты холста 1440×900. Резкая копия — вторая <Picture> с тем же src,
// обрезанная clip-path. Карточка и панель фиксированы по прототипу v11,
// primary-кнопка — через токены --color-primary-*.
import { Picture } from 'astro:assets';
import Icon from '../icons/Icon.astro';
import { cappedImageWidths } from '../../lib/images';

// Структурный тип зоны — подходит и t-taxi (dark), и matchpoint (light) наборам.
interface WalkthroughZone {
  l: number;
  t: number;
  w: number;
  h: number;
  title: string;
  body: string;
}

interface Props {
  src: ImageMetadata;
  // Альтернативный скрин для шага, на котором UI меняет своё состояние
  // (например, открывается confidence-popover в Matchpoint).
  alternateSrc?: ImageMetadata;
  // Номер шага с alternateSrc, начиная с 1.
  alternateStep?: number;
  alt: string;
  title: string;
  description: string;
  touchDescription?: string;
  zones: WalkthroughZone[];
  locale?: 'en' | 'ru';
  hint?: string;
  touchHint?: string;
  cta?: string;
  replayCta?: string;
  maxWidth?: string;
  // Светлая тема (matchpoint): рамка primary-bg, тёплый scrim. По умолчанию dark.
  theme?: 'dark' | 'light';
  // Пропорции сцены под конкретный скрин. По умолчанию 1440/900 (t-taxi).
  aspectRatio?: string;
  // Отдельное выравнивание последнего шага нужно только высоким экранам,
  // где финальная зона находится далеко внизу (matchpoint Activity).
  lastStepAlign?: 'default' | 'bottom';
  // Куда ставить сцену при заходе в разбор и на каждом шаге. `top` — верх сцены
  // у верхнего края окна; так нужно высоким экранам (matchpoint 1440/1535),
  // которые в окно всё равно не помещаются. `center` — сцена строго по
  // вертикальному центру; подходит невысоким широким экранам вроде main page
  // T-Taxi (1440/900), где иначе снизу остаётся пустая полоса и кадр выглядит
  // сдвинутым вверх.
  stageAlign?: 'top' | 'center';
  // В Matchpoint светлая карточка на светлом UI плохо читается в hover-preview,
  // поэтому разбор запускается только явной кнопкой. T-Taxi сохраняет регионы.
  entryMode?: 'regions' | 'button';
  // По умолчанию guided-контролы закреплены у нижнего края viewport. Главный
  // экран T-Taxi — намеренное исключение: панель остаётся внутри сцены.
  controlsPlacement?: 'viewport' | 'stage';
}

const locale = (Astro.props.locale ?? (Astro.currentLocale === 'ru' ? 'ru' : 'en')) as 'en' | 'ru';
const ui = {
  ru: {
    hint: 'Наведите на области экрана или запустите пошаговый разбор.',
    buttonHint: 'Запустите пошаговый разбор экрана.',
    buttonTouchHint: 'Запустите пошаговый разбор экрана.',
    cta: 'Разобрать экран',
    replayCta: 'Посмотреть разбор снова',
    first: 'В начало',
    prev: 'Назад',
    next: 'Далее',
    done: 'Готово',
    close: 'Закрыть разбор',
    captionIdle: 'Наведите — обводка сразу, превью следом. Клик — пошаговый разбор.',
    captionIdleButton: 'Запустите разбор, чтобы пройти экран шаг за шагом.',
    captionIdleButtonTouch: 'Запустите разбор, чтобы пройти экран шаг за шагом.',
    captionKeys: 'двигают рамку между шагами · клик по экрану /',
    captionExit: '— выход',
    captionStarted:
      'Разбор запущен. Стрелки двигают рамку между шагами. Клик по экрану или Esc — выход.',
    captionStartedTouch:
      'Разбор запущен. Используйте кнопки ниже для перехода между шагами.',
    captionCompleted: 'Разбор пройден. Наведите на зоны, чтобы вернуться к любой.',
    captionCompletedButton: 'Разбор пройден. Нажмите кнопку, чтобы посмотреть его снова.',
    captionCompletedButtonTouch:
      'Разбор пройден. Нажмите кнопку, чтобы посмотреть его снова.',
  },
  en: {
    hint: 'Hover over screen areas or start the step-by-step walkthrough.',
    buttonHint: 'Start the step-by-step walkthrough.',
    buttonTouchHint: 'Start the step-by-step walkthrough.',
    cta: 'Break down screen',
    replayCta: 'Watch walkthrough again',
    first: 'Back to start',
    prev: 'Back',
    next: 'Next',
    done: 'Done',
    close: 'Close walkthrough',
    captionIdle: 'Hover — outline first, preview follows. Click — step-by-step walkthrough.',
    captionIdleButton: 'Start the walkthrough to break the screen down step by step.',
    captionIdleButtonTouch: 'Start the walkthrough to break the screen down step by step.',
    captionKeys: 'move the frame between steps · click the screen /',
    captionExit: '— exit',
    captionStarted:
      'Walkthrough started. Arrow keys move the frame between steps. Click the screen or press Esc to exit.',
    captionStartedTouch:
      'Walkthrough started. Use the controls below to move between steps.',
    captionCompleted: 'Walkthrough complete. Hover over zones to jump back to any step.',
    captionCompletedButton: 'Walkthrough complete. Use the button to watch it again.',
    captionCompletedButtonTouch: 'Walkthrough complete. Use the button to watch it again.',
  },
}[locale];

const {
  src,
  alternateSrc,
  alternateStep,
  alt,
  title,
  description,
  touchDescription = description,
  zones,
  entryMode = 'regions',
  hint = entryMode === 'button' ? ui.buttonHint : ui.hint,
  // На touch заход в разбор всегда через кнопку (см. regionsEnabled ниже),
  // поэтому touch-копия — всегда «кнопочная», независимо от entryMode.
  touchHint = ui.buttonTouchHint,
  cta = ui.cta,
  replayCta = ui.replayCta,
  maxWidth = '1440px',
  theme = 'dark',
  aspectRatio = '1440 / 900',
  lastStepAlign = 'default',
  stageAlign = 'top',
  controlsPlacement = 'viewport',
} = Astro.props as Props;

const captionIdle = entryMode === 'button' ? ui.captionIdleButton : ui.captionIdle;
const captionCompleted =
  entryMode === 'button' ? ui.captionCompletedButton : ui.captionCompleted;
const captionIdleTouch = ui.captionIdleButtonTouch;
const captionCompletedTouch = ui.captionCompletedButtonTouch;

// Верхняя ступень доходит до нативной ширины: сцена рисуется вплоть до 1440 CSS,
// а на 2x-экране это 2880 px — иначе Retina получает 1920 и картинка мылит.
const widths = cappedImageWidths(src.width, [720, 1080, 1440, 1920, 2560, 2880]);
const sizes = '(min-width: 92rem) 1440px, calc(100vw - 2rem)';
---

<section
  class="walkthrough not-prose full-bleed"
  data-walkthrough
  data-theme={theme}
  data-entry-mode={entryMode}
  data-controls-placement={controlsPlacement}
  data-alternate-step={alternateStep}
  data-last-step-align={lastStepAlign}
  data-stage-align={stageAlign}
  data-cta={cta}
  data-replay-cta={replayCta}
  data-next-label={ui.next}
  data-done-label={ui.done}
  data-caption-idle={captionIdle}
  data-caption-idle-touch={captionIdleTouch}
  data-caption-started={ui.captionStarted}
  data-caption-started-touch={ui.captionStartedTouch}
  data-caption-completed={captionCompleted}
  data-caption-completed-touch={captionCompletedTouch}
>
  <div class="walkthrough__intro">
    <div>
      <h2>{title}</h2>
      <p>
        <span class="walkthrough__pointer-copy">{description}</span>
        <span class="walkthrough__touch-copy">{touchDescription}</span>
      </p>
      <p class="walkthrough__hint">
        <Icon name="zap" size={16} class="walkthrough__hint-ico" />
        <span class="walkthrough__pointer-copy">{hint}</span>
        <span class="walkthrough__touch-copy">{touchHint}</span>
      </p>
    </div>
    <button class="walkthrough__start" type="button" data-start>{cta}</button>
  </div>

  <div class="walkthrough__wide">
    <div class="walkthrough__stage-wrap" style={`max-width: ${maxWidth};`}>
      <div class="walkthrough__stage explore" data-stage style={`aspect-ratio: ${aspectRatio};`}>
        <div class="walkthrough__layer walkthrough__layer--base">
          {
            theme === 'light' ? (
              // Светлые UI-скриншоты содержат много мелкого текста и тонких
              // линий. Оставляем исходный PNG: AVIF/WebP даже при quality=90
              // заметно смягчают такую графику.
              <img
                src={src.src}
                alt={alt}
                width={src.width}
                height={src.height}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Picture
                src={src}
                alt={alt}
                formats={['avif']}
                fallbackFormat="webp"
                widths={widths}
                sizes={sizes}
                quality={90}
                loading="lazy"
                decoding="async"
              />
            )
          }
        </div>
        {
          alternateSrc && (
            <div class="walkthrough__layer walkthrough__layer--alternate" aria-hidden="true">
              <img
                src={alternateSrc.src}
                alt=""
                width={alternateSrc.width}
                height={alternateSrc.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        }
        <div class="walkthrough__dim"></div>
        {/* Рамка-окно: резкая копия скрина живёт ВНУТРИ рамки и сдвинута на
            -left/-top, поэтому картинка приколота к сцене, а рамка ездит поверх.
            Резкость и рамка — один элемент и не могут разъехаться (был белый
            артефакт при быстрой навигации из-за отдельной clip-path маски). */}
        <div class="walkthrough__frame" data-frame>
          <div class="walkthrough__frame-viewport">
            <div class="walkthrough__reveal" data-reveal>
              {
                theme === 'light' ? (
                  <img
                    src={src.src}
                    alt=""
                    width={src.width}
                    height={src.height}
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                  />
                ) : (
                  <Picture
                    src={src}
                    alt=""
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={widths}
                    sizes={sizes}
                    quality={90}
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                  />
                )
              }
              {
                alternateSrc && (
                  <img
                    class="walkthrough__reveal-alternate"
                    src={alternateSrc.src}
                    alt=""
                    width={alternateSrc.width}
                    height={alternateSrc.height}
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                  />
                )
              }
            </div>
          </div>
        </div>
        <div class="walkthrough__regions">
          {
            zones.map((z, i) => (
              <button
                class="walkthrough__region"
                type="button"
                tabindex="-1"
                data-region
                data-index={i}
                data-l={z.l}
                data-t={z.t}
                data-w={z.w}
                data-h={z.h}
                data-title={z.title}
                data-body={z.body}
                style={`left:${z.l}%;top:${z.t}%;width:${z.w}%;height:${z.h}%;`}
                aria-label={`${i + 1}. ${z.title}`}
              />
            ))
          }
        </div>
        <div class="walkthrough__card" data-card role="dialog" aria-live="polite">
          <div class="walkthrough__step" data-card-step></div>
          <h3 data-card-title></h3>
          <p data-card-body></p>
        </div>
        <div class="walkthrough__controls" data-controls>
          <button
            class="walkthrough__nav walkthrough__nav--icon"
            type="button"
            data-first
            aria-label={ui.first}
            title={ui.first}
          >
            <Icon name="chevron-first" size={14} />
          </button>
          <button class="walkthrough__nav" type="button" data-prev aria-label={ui.prev}>
            <Icon name="chevron-left" size={14} />
            {ui.prev}
          </button>
          <button
            class="walkthrough__nav walkthrough__nav--primary"
            type="button"
            data-next
            aria-label={ui.next}
          >
            <span data-next-text>{ui.next}</span>
            <Icon name="chevron-right" size={14} class="walkthrough__next-go" />
            <Icon name="check" size={14} class="walkthrough__next-done" />
          </button>
          <span class="walkthrough__sep"></span>
          <button class="walkthrough__close" type="button" data-close aria-label={ui.close}>
            <Icon name="x" size={16} />
          </button>
        </div>
      </div>
    </div>
  </div>

  <p class="walkthrough__caption">
    <span data-cap-left>{captionIdle}</span>
    <span class="walkthrough__caption-keys">
      <kbd>←</kbd> <kbd>→</kbd> {ui.captionKeys} <kbd>Esc</kbd> {ui.captionExit}
    </span>
  </p>
</section>

<script>
  import { createStepScroller } from '../../lib/walkthrough-motion';

  const initWalkthrough = (root: HTMLElement, signal: AbortSignal) => {
    if (root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const stage = root.querySelector<HTMLElement>('[data-stage]');
    const frame = root.querySelector<HTMLElement>('[data-frame]');
    const reveal = root.querySelector<HTMLElement>('[data-reveal]');
    const alternateReveal = root.querySelector<HTMLElement>('.walkthrough__reveal-alternate');
    const card = root.querySelector<HTMLElement>('[data-card]');
    const cardStep = root.querySelector<HTMLElement>('[data-card-step]');
    const cardTitle = root.querySelector<HTMLElement>('[data-card-title]');
    const cardBody = root.querySelector<HTMLElement>('[data-card-body]');
    const controls = root.querySelector<HTMLElement>('[data-controls]');
    const firstBtn = root.querySelector<HTMLButtonElement>('[data-first]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const nextText = root.querySelector<HTMLElement>('[data-next-text]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-close]');
    const startBtn = root.querySelector<HTMLButtonElement>('[data-start]');
    const capLeft = root.querySelector<HTMLElement>('[data-cap-left]');
    const wide = root.querySelector<HTMLElement>('.walkthrough__wide');
    const regionEls = [...root.querySelectorAll<HTMLButtonElement>('[data-region]')];

    if (
      !stage ||
      !reveal ||
      !frame ||
      !card ||
      !cardStep ||
      !cardTitle ||
      !cardBody ||
      !controls ||
      !firstBtn ||
      !prevBtn ||
      !nextBtn ||
      !nextText ||
      !closeBtn ||
      !startBtn ||
      !capLeft ||
      regionEls.length === 0
    ) {
      return;
    }

    interface Rect {
      l: number;
      t: number;
      w: number;
      h: number;
    }

    interface Zone extends Rect {
      title: string;
      body: string;
    }

    const zones: Zone[] = regionEls.map((el) => ({
      l: Number(el.dataset.l),
      t: Number(el.dataset.t),
      w: Number(el.dataset.w),
      h: Number(el.dataset.h),
      title: el.dataset.title || '',
      body: el.dataset.body || '',
    }));

    const N = zones.length;
    const lastStepAlign = root.dataset.lastStepAlign || 'default';
    const stageAlign = root.dataset.stageAlign || 'top';
    // Заход в разбор через зоны — только там, где есть настоящий hover.
    // На touch остаётся кнопка: превью по наведению там всё равно нет, тап по
    // зоне конфликтует с горизонтальным панорамированием сцены, а :hover после
    // тапа «залипает». Одна точка входа вместо двух — меньше состояний.
    const hoverCapable = window.matchMedia('(hover: hover)').matches;
    const regionsEnabled = root.dataset.entryMode !== 'button' && hoverCapable;
    const alternateStepIndex =
      alternateReveal && root.dataset.alternateStep
        ? Number(root.dataset.alternateStep) - 1
        : -1;
    const hasAlternateStep =
      Number.isInteger(alternateStepIndex) &&
      alternateStepIndex >= 0 &&
      alternateStepIndex < N;
    const CARD_EXIT = 250;
    const cta = root.dataset.cta || 'Разобрать экран';
    const replayCta = root.dataset.replayCta || 'Посмотреть разбор снова';
    const nextLabel = root.dataset.nextLabel || 'Далее';
    const doneLabel = root.dataset.doneLabel || 'Готово';
    const coarsePointer = window.matchMedia('(pointer: coarse)').matches;
    // Компактная раскладка = та, где сцена шире вьюпорта и уезжает в свой
    // горизонтальный скролл (см. min-width сцены в стилях ниже). Именно она,
    // а не тип указателя, определяет размещение тултипа, панели и скролла.
    const compactQuery = window.matchMedia('(max-width: 47.9375rem)');
    const isCompact = () => compactQuery.matches;
    const captionIdle =
      (coarsePointer ? root.dataset.captionIdleTouch : root.dataset.captionIdle) ||
      'Наведите — обводка сразу, превью следом. Клик — пошаговый разбор.';
    const captionStarted =
      (coarsePointer ? root.dataset.captionStartedTouch : root.dataset.captionStarted) ||
      'Разбор запущен. Стрелки двигают рамку между шагами. Клик по экрану или Esc — выход.';
    const captionCompleted =
      (coarsePointer ? root.dataset.captionCompletedTouch : root.dataset.captionCompleted) ||
      'Разбор пройден. Наведите на зоны, чтобы вернуться к любой.';

    let idx = -1;
    let guided = false;
    let completed = false;
    let hoverIdx = -1;
    let cardShownIdx = -1;
    let cardBusy = false;

    const reflow = (el: HTMLElement) => void el.offsetWidth;
    const setAlternateVisible = (visible: boolean) => {
      stage.classList.toggle('alternate-visible', visible);
    };

    // Рамка-окно + приколотая резкая копия. Рамку ставим в % сцены, а копию
    // внутри рамки — в px, размером со сцену и со сдвигом на -left/-top, чтобы её
    // (0,0) совпадал с (0,0) сцены. Обе величины анимируются одним и тем же
    // left/top-переходом и математически связаны, поэтому не разъезжаются даже
    // при быстром прерывании навигации.
    const setFramePos = (r: Rect) => {
      frame.style.left = r.l + '%';
      frame.style.top = r.t + '%';
      frame.style.width = r.w + '%';
      frame.style.height = r.h + '%';
      const W = stage.clientWidth;
      const H = stage.clientHeight;
      reveal.style.width = W + 'px';
      reveal.style.height = H + 'px';
      // Не округляем: SVG-рамки намеренно стоят на полуцелых координатах.
      // Округление сдвигало sharp-копию относительно border на 0.5px, и
      // визуальный отступ 4px на части сторон превращался в 3px.
      reveal.style.left = -((r.l / 100) * W) + 'px';
      reveal.style.top = -((r.t / 100) * H) + 'px';
    };

    // Все разборы используют viewport-fixed контролы, кроме явно помеченного
    // main page T-Taxi: там панель должна оставаться у нижнего края сцены.
    // На компактной раскладке исключения нет: сцена там шире вьюпорта, и панель,
    // отцентрованная по сцене, наполовину уезжает за экран. Фиксируем во
    // вьюпорте — тогда она всегда строго по центру и всегда достижима.
    //
    // Видимость панели и её режим позиционирования — РАЗНЫЕ вещи и живут на
    // разных элементах (.guided на сцене гасит opacity, .controls-fixed на
    // корне задаёт fixed). Снимать их одновременно нельзя: fixed→absolute
    // срабатывает мгновенно, и панель на глазах улетает внутрь сцены прямо
    // во время затухания. Поэтому режим переключаем только после кроссфейда.
    const CONTROLS_EXIT_MS = 240;
    let controlsModeTimer = 0;
    const updateControlsMode = () => {
      window.clearTimeout(controlsModeTimer);
      const fixedToViewport = isCompact() || root.dataset.controlsPlacement !== 'stage';
      if (guided) {
        root.classList.toggle('controls-fixed', fixedToViewport);
        return;
      }
      if (!root.classList.contains('controls-fixed')) return;
      controlsModeTimer = window.setTimeout(() => {
        if (!guided) root.classList.remove('controls-fixed');
      }, CONTROLS_EXIT_MS);
    };

    // Снимаем фокус с элемента разбора (зона/кнопка), чтобы после клика+клавиш
    // и особенно после Esc не оставалось :focus-visible обводки. Клавиатурная
    // навигация идёт через глобальный keydown и панель, а не через зоны.
    const clearFocus = () => {
      const active = document.activeElement;
      if (active instanceof HTMLElement && root.contains(active)) active.blur();
    };

    const fillCard = (i: number) => {
      const z = zones[i];
      cardStep.textContent = i + 1 + ' / ' + N;
      cardTitle.textContent = z.title;
      cardBody.textContent = z.body;
    };

    const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

    // Минимальный отступ карточки от краёв экрана сервиса на компактной
    // раскладке (совпадает с вертикальным зазором полосы шага).
    const COMPACT_EDGE_INSET = 16;

    // Карточка всегда живёт внутри сцены и позиционируется относительно UI
    // сервиса, а не вьюпорта. Различается только сторона привязки:
    // десктоп — сбоку от зоны, компактная раскладка — над зоной или под ней.
    const placeCard = (r: Rect, fg: boolean, below = false) => {
      const W = stage.clientWidth;
      const H = stage.clientHeight;
      const fl = (r.l / 100) * W;
      const ft = (r.t / 100) * H;
      const fw = (r.w / 100) * W;
      const fh = (r.h / 100) * H;
      const cw = card.offsetWidth || 336;
      const ch = card.offsetHeight || 120;
      const gap = 14;
      const compact = isCompact();
      // Панель управления на компактной раскладке зафиксирована во вьюпорте,
      // поэтому место под неё внутри сцены резервировать не нужно.
      const maxTop = H - ch - (fg && !compact ? 96 : 12);
      // Отступ от краёв экрана сервиса. На компактной раскладке он заметный:
      // у зоны, прижатой к краю, карточка иначе залипает вплотную к границе.
      const edge = compact ? COMPACT_EDGE_INSET : 10;
      let left: number;
      let top: number;
      if (compact) {
        // Строго над зоной или под ней: сбоку карточка увела бы из вида саму
        // зону — сцена здесь шире экрана. По горизонтали равняем карточку с
        // зоной по ближней стороне (левый край к левому / правый к правому),
        // а не по центру.
        left = fl + fw / 2 < W / 2 ? fl : fl + fw - cw;
        const belowTop = ft + fh + gap;
        const aboveTop = ft - gap - ch;
        if (belowTop <= maxTop) top = belowTop;
        else if (aboveTop >= edge) top = aboveTop;
        // Ни снизу, ни сверху не помещается (зона почти во всю высоту) —
        // уводим карточку вниз экрана сервиса, а не оставляем по центру зоны.
        else top = maxTop;
      } else if (below) {
        // Под зоной, по центру — так карточка не перекрывает раскрытый поповер.
        left = fl + fw / 2 - cw / 2;
        top = ft + fh + gap;
      } else {
        // Сторона по свободному месту, карточка вплотную к зоне (v11).
        const cx = fl + fw / 2;
        left = cx < W / 2 ? fl + fw + gap : fl - gap - cw;
        // Выравнивание по верху зоны (v11), а не центрирование.
        top = ft;
      }
      left = clamp(left, edge, Math.max(edge, W - cw - edge));
      top = clamp(top, edge, Math.max(edge, maxTop));
      card.style.left = Math.round(left) + 'px';
      card.style.top = Math.round(top) + 'px';
    };

    const setNextLabel = (i: number) => {
      const last = i === N - 1;
      nextText.textContent = last ? doneLabel : nextLabel;
      nextBtn.classList.toggle('is-last', last);
    };

    // ── Explore-режим: последовательная смена peek-карточек (без наложения) ──
    const showCardVisual = (i: number) => {
      fillCard(i);
      // peek без счётчика. step-static замораживает переход .step, поэтому после
      // выхода из guided счётчик не «доигрывает» появление/сворачивание — он
      // просто отсутствует, а карточка приезжает обычным fade + translateY.
      card.classList.remove('moving');
      card.classList.add('step-static');
      card.classList.remove('stepped');
      placeCard(zones[i], false);
      card.classList.add('show');
    };
    const hideCardVisual = () => card.classList.remove('show');

    const syncCard = () => {
      if (guided || cardBusy) return;
      if (hoverIdx === cardShownIdx) return;
      if (cardShownIdx !== -1) {
        hideCardVisual();
        cardShownIdx = -1;
        cardBusy = true;
        setTimeout(() => {
          cardBusy = false;
          syncCard();
        }, CARD_EXIT);
      } else if (hoverIdx !== -1) {
        showCardVisual(hoverIdx);
        cardShownIdx = hoverIdx;
      }
    };

    // Пока идёт наш программный скролл (вход / навигация), автовыход по уходу
    // сцены из вида подавляется — иначе промежуточные кадры плавного скролла
    // закрыли бы разбор ещё до того, как сцена доедет до целевой позиции.
    let suppressExitUntil = 0;

    // ── Фокус-скролл ──
    // Шаги 1–7 показываем с верхом Exception Detail у верхнего края viewport.
    // Если при таком положении карточка не помещается, карточка приоритетнее и
    // scrollY дополнительно корректируется. Последний шаг сохраняет отдельное
    // нижнее выравнивание для Activity.
    const STAGE_TOP_GAP = 64;
    const TOOLTIP_GAP = 16;
    const TOOLTIP_BOTTOM_GAP = 88; // место над фиксированной панелью
    const ZONE_BOTTOM_GAP = 104; // с запасом под липкую панель управления

    const frameEdgesPage = (i: number) => {
      const z = zones[i];
      const rect = stage.getBoundingClientRect();
      const stageTopPage = window.scrollY + rect.top;
      const stageH = rect.height;
      return {
        top: stageTopPage + (z.t / 100) * stageH,
        bottom: stageTopPage + ((z.t + z.h) / 100) * stageH,
      };
    };

    // Скролл шага едет на общем клоке с CSS-переходами рамки и карточки —
    // иначе их разность на экране идёт по дуге (см. walkthrough-motion.ts).
    const stepScroller = createStepScroller(wide, (ms) => {
      suppressExitUntil = performance.now() + ms + 140;
    });
    const tweenScroll = (dy: number, dx: number) => stepScroller.by(dy, dx);
    const cancelStepTween = () => stepScroller.cancel();

    // Полоса шага по горизонтали: зона + карточка. Раньше учитывалась только
    // карточка, и при боковом размещении сцена уезжала так, что сама зона
    // оказывалась за краем. Двигаем на минимум — как block:'nearest'.
    const stepBandX = (i: number) => {
      const stageRect = stage.getBoundingClientRect();
      const W = stage.clientWidth;
      const z = zones[i];
      const zoneLeft = stageRect.left + (z.l / 100) * W;
      const zoneRight = stageRect.left + ((z.l + z.w) / 100) * W;
      const cardLeft = stageRect.left + (parseFloat(card.style.left) || 0);
      return {
        start: Math.min(zoneLeft, cardLeft),
        end: Math.max(zoneRight, cardLeft + card.offsetWidth),
      };
    };

    const stepScrollDeltaX = (i: number) => {
      if (!wide) return 0;
      if (Math.max(0, wide.scrollWidth - wide.clientWidth) === 0) return 0;
      const wideRect = wide.getBoundingClientRect();
      const { start, end } = stepBandX(i);
      const visibleStart = Math.max(0, wideRect.left) + TOOLTIP_GAP;
      const visibleEnd = Math.min(window.innerWidth, wideRect.right) - TOOLTIP_GAP;

      if (end - start > visibleEnd - visibleStart) {
        // Полоса шире окна: показать целиком нельзя — центрируем её.
        return (start + end) / 2 - (visibleStart + visibleEnd) / 2;
      }
      if (start < visibleStart) return start - visibleStart;
      if (end > visibleEnd) return end - visibleEnd;
      return 0;
    };

    // Базовое положение сцены до поправок на тултип. При `center` сцена встаёт
    // строго по вертикальному центру окна — но только если она в него влезает:
    // у высокой сцены (matchpoint) свободного места нет, и центрирование срезало
    // бы её сверху, поэтому там остаётся выравнивание по верху.
    const stageBaseTargetY = (stageTopPage: number, stageHeight: number) => {
      const slack = window.innerHeight - stageHeight;
      if (stageAlign === 'center' && slack > 0) return stageTopPage - slack / 2;
      return stageTopPage - STAGE_TOP_GAP;
    };

    const topAlignTargetY = () => {
      const stageRect = stage.getBoundingClientRect();
      const stageTopPage = window.scrollY + stageRect.top;
      const cardTopPage = stageTopPage + (parseFloat(card.style.top) || 0);
      const cardBottomPage = cardTopPage + card.offsetHeight;
      let targetY = stageBaseTargetY(stageTopPage, stageRect.height);

      // Положение сцены — базовое, но тултип никогда не оставляем за краем.
      if (cardTopPage - targetY < TOOLTIP_GAP) {
        targetY = cardTopPage - TOOLTIP_GAP;
      }
      if (cardBottomPage - targetY > window.innerHeight - TOOLTIP_BOTTOM_GAP) {
        targetY = cardBottomPage - window.innerHeight + TOOLTIP_BOTTOM_GAP;
      }

      return targetY;
    };

    // Последний шаг: низ фрейма чуть выше низа экрана.
    const bottomAlignTargetY = (i: number) => {
      const { bottom } = frameEdgesPage(i);
      const stageRect = stage.getBoundingClientRect();
      const stageTopPage = window.scrollY + stageRect.top;
      const cardTopPage = stageTopPage + (parseFloat(card.style.top) || 0);
      const cardBottomPage = cardTopPage + card.offsetHeight;
      let targetY = bottom - window.innerHeight + ZONE_BOTTOM_GAP;

      if (cardTopPage - targetY < TOOLTIP_GAP) {
        targetY = cardTopPage - TOOLTIP_GAP;
      }
      if (cardBottomPage - targetY > window.innerHeight - TOOLTIP_BOTTOM_GAP) {
        targetY = cardBottomPage - window.innerHeight + TOOLTIP_BOTTOM_GAP;
      }

      return targetY;
    };

    // Компактная раскладка: сцена целиком помещается по высоте, поэтому
    // переставлять страницу на каждом шаге незачем — любой лишний скролл сбивает
    // ориентацию. Двигаем ровно настолько, чтобы шаг (зона + карточка) попал в
    // видимую полосу, и не двигаем совсем, если он уже там: это семантика
    // scrollIntoView({block:'nearest'}), только для составного прямоугольника.
    // Десктоп сохраняет свои осознанные выравнивания (верх сцены / низ зоны).
    const COMPACT_TOP_GAP = 16;
    const COMPACT_BOTTOM_GAP = 96; // фиксированная панель управления + зазор

    const compactScrollDeltaY = (i: number) => {
      const stageRect = stage.getBoundingClientRect();
      const H = stage.clientHeight;
      const z = zones[i];
      const zoneTop = stageRect.top + (z.t / 100) * H;
      const zoneBottom = stageRect.top + ((z.t + z.h) / 100) * H;
      const cardTop = stageRect.top + (parseFloat(card.style.top) || 0);
      const bandTop = Math.min(zoneTop, cardTop);
      const bandBottom = Math.max(zoneBottom, cardTop + card.offsetHeight);
      const safeBottom = window.innerHeight - COMPACT_BOTTOM_GAP;

      // Шаг выше полосы и уже перекрывает её целиком — не дёргаем.
      if (bandTop < COMPACT_TOP_GAP && bandBottom > safeBottom) return 0;
      if (bandTop < COMPACT_TOP_GAP) return bandTop - COMPACT_TOP_GAP;
      if (bandBottom > safeBottom) {
        // Подтягиваем снизу, но не настолько, чтобы срезать верх шага.
        return Math.min(bandBottom - safeBottom, bandTop - COMPACT_TOP_GAP);
      }
      return 0;
    };

    const focusStepInViewport = (i: number) => {
      const targetY = isCompact()
        ? window.scrollY + compactScrollDeltaY(i)
        : i === N - 1 && lastStepAlign === 'bottom'
          ? bottomAlignTargetY(i)
          : topAlignTargetY();
      tweenScroll(targetY - window.scrollY, stepScrollDeltaX(i));
    };

    // ── Вход в guided ──
    const enterGuided = (i: number, fromPeek: boolean) => {
      setAlternateVisible(false);
      guided = true;
      clearFocus();
      stage.classList.remove('explore');
      stage.classList.add('guided');
      root.classList.add('is-guided');
      // Только один активный разбор: другие закрываются.
      document.dispatchEvent(new CustomEvent('t-walkthrough-open', { detail: root }));

      const cameFromVisiblePeek = fromPeek && cardShownIdx === i;
      hoverIdx = -1;
      cardShownIdx = -1;
      cardBusy = false;

      updateControlsMode();
      frame.classList.remove('moving');
      reveal.classList.remove('moving');
      reflow(frame);
      setFramePos(zones[i]);
      fillCard(i);
      card.classList.remove('moving');

      if (cameFromVisiblePeek) {
        // Клик по зоне с уже видимым peek: карточка «дорастает» счётчиком
        // (анимация max-height у .step), рамка фейдится с утолщением. Не
        // переезжает — КРОМЕ случая, когда выросшая карточка налезла бы на
        // панель управления: тогда плавно поднимаем её ровно настолько, чтобы
        // не перекрывать (вариант C).
        card.classList.remove('step-static');
        setNextLabel(i);
        prevBtn.disabled = i === 0;
        firstBtn.disabled = i === 0;
        frame.classList.add('on');
        card.classList.add('show', 'stepped');
        // .step вырастет на max-height 22px + margin-bottom 12px = 34px.
        // Резерв под панель имеет смысл только там, где она внутри сцены, то
        // есть на десктопе; на компактной раскладке над/под зоной уже уложено.
        if (!isCompact()) {
          const stepDelta = 34;
          const chFinal = card.offsetHeight + stepDelta;
          const curTop = parseFloat(card.style.top) || 0;
          const maxTop = stage.clientHeight - chFinal - 96;
          if (curTop > maxTop) {
            card.classList.add('moving');
            card.style.top = Math.round(Math.max(10, maxTop)) + 'px';
            window.setTimeout(() => card.classList.remove('moving'), 460);
          }
        }
      } else {
        // Вход через кнопку (без предварительного hover): карточка подъезжает
        // снизу вверх с fade-in, как peek, но счётчик показан сразу вместе с
        // карточкой — без отдельной «растущей» анимации (.step-static).
        card.classList.remove('show');
        card.classList.add('stepped', 'step-static');
        placeCard(zones[i], true);
        setNextLabel(i);
        prevBtn.disabled = i === 0;
        firstBtn.disabled = i === 0;
        reflow(card);
        frame.classList.add('on');
        card.classList.add('show');
      }

      idx = i;
      if (hasAlternateStep && i === alternateStepIndex) setAlternateVisible(true);
      focusStepInViewport(i);
      capLeft.textContent = captionStarted;
    };

    // Визуальная часть шага отделена от запроса навигации, чтобы рамка и
    // alternate-скрин могли стартовать одновременно, но жить в своём темпе:
    // рамка перелетает за 420ms, обычный UI-crossfade заканчивается раньше.
    const applyStepVisual = (i: number) => {
      [frame, card, reveal].forEach((el) => el.classList.add('moving'));
      reflow(frame);
      setFramePos(zones[i]);
      fillCard(i);
      placeCard(zones[i], true);
      setNextLabel(i);
      prevBtn.disabled = i === 0;
      firstBtn.disabled = i === 0;
      frame.classList.add('on');
      card.classList.add('show', 'stepped');
      focusStepInViewport(i);
    };

    const step = (i: number) => {
      if (i < 0 || i >= N) return;
      idx = i;
      applyStepVisual(i);
      setAlternateVisible(hasAlternateStep && i === alternateStepIndex);
    };

    const next = () => {
      if (idx < N - 1) step(idx + 1);
      else {
        completed = true;
        closeGuided();
      }
    };
    const prev = () => {
      if (idx > 0) step(idx - 1);
    };

    const closeGuided = () => {
      setAlternateVisible(false);
      guided = false;
      // Esc/закрытие: снимаем фокус, иначе на зоне остаётся :focus-visible обводка.
      clearFocus();
      stage.classList.remove('guided');
      stage.classList.add('explore');
      root.classList.remove('is-guided');
      updateControlsMode();
      frame.classList.remove('on', 'moving');
      reveal.classList.remove('moving');
      // Выход: только fade-out + отъезд карточки вниз, как при уходе курсора из
      // зоны. Счётчик шага НЕ сворачивается своей анимацией — .step-static
      // замораживает переход .step, 'stepped' остаётся, гаснет вместе с карточкой.
      card.classList.add('step-static');
      card.classList.remove('show', 'moving');
      idx = -1;
      hoverIdx = -1;
      cardShownIdx = -1;
      cardBusy = false;
      startBtn.textContent = completed ? replayCta : cta;
      capLeft.textContent = completed ? captionCompleted : captionIdle;
    };

    if (regionsEnabled) {
      regionEls.forEach((el, i) => {
        el.addEventListener('mouseenter', () => {
          if (guided) return;
          hoverIdx = i;
          syncCard();
        });
        el.addEventListener('mouseleave', () => {
          if (guided) return;
          if (hoverIdx === i) {
            hoverIdx = -1;
            syncCard();
          }
        });
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          if (guided) {
            // Клик по активной зоне — остаёмся в разборе. Клик по любой другой
            // зоне визуально приходится на затемнение (остальные зоны скрыты),
            // поэтому ощущается как клик по фону → выходим из разбора.
            if (i !== idx) closeGuided();
            return;
          }
          enterGuided(i, true);
        });
      });
    }

    // Прайм окна: сразу задаём резкой копии размер (рамка скрыта, opacity 0),
    // чтобы её ленивое изображение загрузилось вместе со сценой, а не в момент
    // первого шага — иначе на первом клике окно мигнёт пустым.
    setFramePos(zones[0]);

    document.addEventListener('t-walkthrough-open', (e) => {
      if ((e as CustomEvent).detail !== root && guided) closeGuided();
    }, { signal });

    // Выход — только клик ВНЕ скриншота (не по сцене, панели и кнопке запуска).
    document.addEventListener('click', (e) => {
      if (!guided) return;
      const t = e.target as Node;
      if (stage.contains(t) || controls.contains(t) || startBtn.contains(t)) return;
      closeGuided();
    }, { signal });

    startBtn.addEventListener('click', () => enterGuided(0, false));
    firstBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (idx > 0) step(0);
    });
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      next();
    });
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      prev();
    });
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeGuided();
    });
    card.addEventListener('click', (e) => e.stopPropagation());
    controls.addEventListener('click', (e) => e.stopPropagation());
    // Клик по сцене мимо зоны — выход (по зонам стоит stopPropagation).
    stage.addEventListener('click', () => {
      if (guided) closeGuided();
    });

    window.addEventListener('keydown', (e) => {
      if (!guided) return;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        next();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prev();
      } else if (e.key === 'Home') {
        e.preventDefault();
        if (idx > 0) step(0);
      } else if (e.key === 'Escape') {
        e.preventDefault();
        closeGuided();
      }
    }, { signal });

    let rt: number;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        updateControlsMode();
        // Сцена сменила размер — пересчитать окно резкости и позицию карточки.
        if (guided && idx >= 0) {
          setFramePos(zones[idx]);
          placeCard(zones[idx], true);
        } else if (cardShownIdx >= 0) placeCard(zones[cardShownIdx], false);
      }, 80);
    }, { signal });

    // ── Автовыход при уходе сцены из вида ──
    // Сцена скрылась (проскроллили по вертикали или увели вбок во внутреннем
    // горизонтальном скролле) → выходим из разбора. Порог — ~30% видимой части
    // сцены по каждой оси; min(размер сцены, размер вьюпорта) корректно
    // обрабатывает сцену выше/шире вьюпорта.
    const isStageMostlyVisible = () => {
      const r = stage.getBoundingClientRect();
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const visibleX = Math.min(r.right, vw) - Math.max(r.left, 0);
      const visibleY = Math.min(r.bottom, vh) - Math.max(r.top, 0);
      const minX = Math.min(r.width, vw) * 0.3;
      const minY = Math.min(r.height, vh) * 0.3;
      return visibleX > minX && visibleY > minY;
    };

    let exitRaf = 0;
    const onViewportScroll = () => {
      if (exitRaf) return;
      exitRaf = window.requestAnimationFrame(() => {
        exitRaf = 0;
        const visible = isStageMostlyVisible();
        if (!guided) return;
        if (performance.now() < suppressExitUntil) return;
        if (!visible) closeGuided();
      });
    };

    window.addEventListener('scroll', onViewportScroll, { passive: true, signal });
    wide?.addEventListener('scroll', onViewportScroll, { passive: true, signal });

    // Свой tween, в отличие от behavior:'smooth', сам по себе не прерывается
    // жестом пользователя — прерываем явно, иначе он перебивал бы прокрутку.
    (['wheel', 'touchstart'] as const).forEach((type) => {
      window.addEventListener(type, cancelStepTween, { passive: true, signal });
    });

    signal.addEventListener('abort', () => {
      window.clearTimeout(rt);
      window.clearTimeout(controlsModeTimer);
      window.cancelAnimationFrame(exitRaf);
      cancelStepTween();
    }, { once: true });
  };

  let activeWalkthroughRoots: HTMLElement[] = [];
  let cleanupWalkthroughs: (() => void) | undefined;

  const initWalkthroughs = () => {
    const roots = [...document.querySelectorAll<HTMLElement>('[data-walkthrough]')];
    const isSamePage =
      roots.length === activeWalkthroughRoots.length &&
      roots.every((root, index) => root === activeWalkthroughRoots[index]);
    if (isSamePage) return;

    cleanupWalkthroughs?.();
    cleanupWalkthroughs = undefined;
    activeWalkthroughRoots = roots;
    if (roots.length === 0) return;

    const controller = new AbortController();
    const { signal } = controller;
    const cleanup = () => {
      controller.abort();
      if (activeWalkthroughRoots === roots) activeWalkthroughRoots = [];
      if (cleanupWalkthroughs === cleanup) cleanupWalkthroughs = undefined;
    };
    cleanupWalkthroughs = cleanup;
    document.addEventListener('astro:before-swap', cleanup, { once: true, signal });
    roots.forEach((root) => initWalkthrough(root, signal));
  };

  document.addEventListener('astro:page-load', initWalkthroughs);
  initWalkthroughs();
</script>


---
// Responsive image frame for the homepage. It intentionally avoids LQIP:
// images load as sharp frames without a placeholder effect.
import { Image } from 'astro:assets';
import { cappedImageWidths } from '../../lib/images';
import { resolveImageAsset } from '../../lib/assets';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths?: number[];
  sizes?: string;
  /** Классы рамки-frame: размеры, border, radius, отступы. */
  class?: string;
  /** Доп. классы для <img>. */
  imgClass?: string;
  /** Грузить сразу, без ожидания раскладки: `loading="eager"`. */
  eager?: boolean;
  /**
   * `fetchpriority="high"` — только для кандидатов в LCP. По умолчанию повторяет
   * `eager`, чтобы прежние вызовы вели себя как раньше.
   *
   * Разведено с `eager` намеренно: «картинка выше сгиба» и «картинка важнее
   * остальных» — разные вещи. Above-the-fold нельзя вешать `lazy` (браузер
   * дождётся раскладки и потеряет round trip), но и раздавать всем high нельзя —
   * приоритет размывается, и настоящий LCP встаёт в очередь наравне с фоновыми.
   */
  priority?: boolean;
}

const {
  src: source,
  alt,
  widths = [480, 720, 960],
  sizes,
  class: frameClass,
  imgClass,
  eager = false,
  priority = eager,
} = Astro.props as Props;

const src = resolveImageAsset(source, 'BlurImage.astro');
const responsiveWidths = cappedImageWidths(src.width, widths);
---

<div class:list={['image-frame', frameClass]}>
  <Image
    src={src}
    alt={alt}
    widths={responsiveWidths}
    sizes={sizes}
    format="webp"
    class:list={['frame-img', imgClass]}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
</div>

<style>
  .image-frame {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-subtle);
  }
  /* .frame-img висит на <img> из <Image> — без scoped-cid этого компонента,
     поэтому селекторы глобальные. */
  :global(.frame-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

---
import { readFileSync } from 'node:fs';
import { join, normalize, sep } from 'node:path';
import { namespaceSvgIds, svgIdPrefix } from '../../lib/svg';

interface Props {
  src: string;
  alt: string;
  className?: string;
  fit?: 'intrinsic' | 'container';
  /**
   * Сделать сам блок горизонтальным скроллером. Нужно там, где над схемой нет
   * скролл-контейнера (Breakout), иначе схема в натуральном масштабе обрежется.
   */
  scroll?: boolean;
}

const { src, alt, className, fit = 'intrinsic', scroll = false } = Astro.props as Props;

const publicRoot = normalize(join(process.cwd(), 'public')) + sep;
const relativeSrc = src.startsWith('/') ? src.slice(1) : src;
const filePath = normalize(join(process.cwd(), 'public', relativeSrc));

if (!filePath.startsWith(publicRoot)) {
  throw new Error(`[PublicSvg] SVG path escapes public/: ${src}`);
}

let svg = readFileSync(filePath, 'utf8');
svg = namespaceSvgIds(svg, svgIdPrefix(relativeSrc));

// Натуральная (макетная) ширина схемы: width, иначе третье число viewBox.
// Она задаёт единый масштаб чтения — 100% — на узких экранах (примитив
// .schema в global.css).
const naturalWidth =
  Number.parseFloat(svg.match(/\swidth="([\d.]+)"/)?.[1] ?? '') ||
  Number.parseFloat(svg.match(/\sviewBox="[\d.-]+\s+[\d.-]+\s+([\d.]+)/)?.[1] ?? '');

if (!Number.isFinite(naturalWidth) || naturalWidth <= 0) {
  throw new Error(`[PublicSvg] cannot read natural width of ${src}`);
}
---

<div
  class:list={[
    'public-svg schema',
    fit === 'container' && 'public-svg--container',
    scroll && 'public-svg--scroll',
    className,
  ]}
  style={`--schema-natural:${naturalWidth}px`}
  role="img"
  aria-label={alt}
>
  <Fragment set:html={svg} />
</div>

<style>
  .public-svg {
    display: block;
    max-width: 100%;
  }

  .public-svg :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  /* Масштаб 100% и концевой отступ на узких экранах — примитив .schema
     в global.css (--schema-natural выставлен на корне выше). */

  .public-svg--container,
  .public-svg--container :global(svg) {
    width: 100%;
  }

  .public-svg--scroll {
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  /* Inlined SVGs share one document, so a bare `text{}` rule inside any of
     them (e.g. the JetBrains-Mono @font-face chart) leaks and clobbers every
     other schema's font. Re-assert the intended family per attribute so the
     leak can't win (attribute selector out-specifies a bare `text`). */
  .public-svg :global(text[font-family='Inter']) {
    font-family: var(--font-diagram);
    font-synthesis: none;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .public-svg :global(text[font-family='JetBrains Mono']) {
    font-family: var(--font-mono);
  }

</style>

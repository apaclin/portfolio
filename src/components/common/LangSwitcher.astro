---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../../i18n/ui';
import { stripLocale } from '../../i18n/paths';
import { alternateLocale, resolveLocale } from '../../lib/i18n';

const current = resolveLocale(Astro.currentLocale);
const other = alternateLocale(current);

// «Логический путь» без языкового префикса (общий хелпер).
const basePath = stripLocale(Astro.url.pathname);

// Строим ссылку на ТУ ЖЕ страницу в другой локали.
// getRelativeLocaleUrl сам добавит/уберёт префикс по конфигу i18n.
const href = getRelativeLocaleUrl(other, basePath);

const t = useTranslations(current);
---

<!-- Переключатель — обвязка страницы, а не ссылка в тексте, поэтому живёт по
     тому же правилу, что контакты в шапке и список проектов: подчёркивание по
     ховеру, а не постоянное, плюс видимый focus-visible для клавиатуры. -->
<a
  href={href}
  hreflang={other}
  class="text-sm underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
>
  {t('action.switchLang')}
</a>

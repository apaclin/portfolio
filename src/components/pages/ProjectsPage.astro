---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Icon from '../icons/Icon.astro';
import BlurImage from '../common/BlurImage.astro';
import TranslationNotice from '../common/TranslationNotice.astro';
import filmazeCover from '../../assets/images/project-covers/filmaze.webp';
import bergstromCover from '../../assets/images/project-covers/bergstrom.webp';
import radixCover from '../../assets/images/pet-projects/radix-cover.png';
import joeTheZombieCover from '../../assets/images/games/joe-the-zombie.png';
import pirateTreasuresCover from '../../assets/images/games/pirate-treasures.webp';
import candyValleyCover from '../../assets/images/games/candy-valley.webp';
import portrait from '../../assets/images/profile/alexander-paklin.jpg';
import { resolveImageAsset } from '../../lib/assets';
import type { Locale } from '../../lib/i18n';

interface ProjectItem {
  title: string;
  subtitle?: string;
  href?: string;
  external?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
  comingSoon?: boolean;
}

interface ProjectSection {
  title: string;
  items: ProjectItem[];
}

interface LinkItem {
  label: string;
  href: string;
  external?: boolean;
  /**
   * Значение, которое кладётся в буфер обмена по клику ВМЕСТО перехода.
   *
   * Обе схемы здесь ненадёжны, и обычный переход у них не «иногда не работает»,
   * а ломается заметно. `mailto:` в Arc без назначенного почтового клиента
   * открывает поверх страницы плавающее окно Little Arc с `about:blank` — пустое
   * окно во весь экран вместо письма. `t.me` в РФ недоступен и ведёт в никуда.
   *
   * Href остаётся на элементе: он даёт семантику ссылки и сохраняет
   * cmd/ctrl-клик, среднюю кнопку и правый клик → «Открыть» для тех, у кого
   * переход всё-таки работает (см. обработчик ниже — модификаторы не
   * перехватываются).
   */
  copy?: string;
}

interface ProjectsContent {
  portraitAlt: string;
  role: string;
  name: string;
  intro: string;
  openLabel: string;
  /** Текст уведомления о копировании контакта. */
  copiedLabel: string;
  contactLinks: LinkItem[];
  casesTitle: string;
  visualTitle: string;
  gamesTitle: string;
  petTitle: string;
}

/**
 * Вариант главной. `games` — версия для игровых работодателей: секция игр
 * поднимается наверх, интро и ссылка на резюме свои. Всё остальное общее с
 * обычной главной намеренно: два независимых набора проектов пришлось бы
 * править дважды и они бы разъехались.
 */
type PageVariant = 'default' | 'games';

interface Props {
  locale?: Locale;
  fallbackContentLocale?: Locale;
  variant?: PageVariant;
}

const {
  locale = 'en',
  fallbackContentLocale,
  variant = 'default',
} = Astro.props as Props;

const isGames = variant === 'games';

// Резюме под игровой вариант — отдельный документ, но ссылка одна на обе
// локали, как и у общего резюме.
const resumeHref = isGames
  ? 'https://docs.google.com/document/d/1hxyxdCMhaicSGwf47sa_F8ka9x6TNzEx9MqgoDPccB0/edit?usp=sharing'
  : 'https://docs.google.com/document/d/1e_xussfmk_DTICCzpA5pLb9ZqeRFfBTKdJ7fnYEnZ8k/edit?tab=t.0#heading=h.5x0d5h95i329';

const localized: Record<Locale, ProjectsContent> = {
  en: {
    portraitAlt: 'Alex Paclin',
    role: 'Product Designer',
    name: 'Alex Paclin',
    intro: isGames
      ? 'I design game interfaces — HUD, menus, shops, design systems — and I know how to work with complex product processes.'
      : 'I turn complex B2B workflows and data into clear product interfaces.',
    openLabel: 'Open',
    copiedLabel: 'Copied',
    contactLinks: [
      {
        label: 'Resume',
        href: resumeHref,
        external: true,
      },
      {
        label: 'LinkedIn',
        href: 'https://www.linkedin.com/in/apaclin/',
        external: true,
      },
      {
        label: 'Telegram',
        href: 'https://t.me/apaclin',
        external: true,
        copy: '@apaclin',
      },
      {
        label: 'Email',
        href: 'mailto:apaclin@gmail.com',
        copy: 'apaclin@gmail.com',
      },
    ],
    casesTitle: 'B2B web services',
    visualTitle: 'Apps and websites',
    gamesTitle: 'Games',
    petTitle: 'Pet projects',
  },
  ru: {
    portraitAlt: 'Александр Паклин',
    role: 'Продуктовый дизайнер',
    name: 'Александр Паклин',
    intro: isGames
      ? 'Проектирую интерфейсы для игр — HUD, меню, магазины, дизайн-система — и умею работать со сложными продуктовыми процессами.'
      : 'Превращаю сложные B2B-процессы и данные в понятные интерфейсы продукта.',
    openLabel: 'Открыть',
    copiedLabel: 'Скопировано',
    contactLinks: [
      {
        label: 'Резюме',
        href: resumeHref,
        external: true,
      },
      {
        label: 'LinkedIn',
        href: 'https://www.linkedin.com/in/apaclin/',
        external: true,
      },
      {
        label: 'Telegram',
        href: 'https://t.me/apaclin',
        external: true,
        copy: '@apaclin',
      },
      {
        label: 'Email',
        href: 'mailto:apaclin@gmail.com',
        copy: 'apaclin@gmail.com',
      },
    ],
    casesTitle: 'B2B веб-сервисы',
    visualTitle: 'Приложения и сайты',
    gamesTitle: 'Игры',
    petTitle: 'Pet-проекты',
  },
};

const content = localized[locale];
const { contactLinks } = content;

const collectionName = locale === 'ru' ? 'casesRu' : 'casesEn';
const rawCases = await getCollection(collectionName);
const caseItems: ProjectItem[] = [...rawCases]
  .sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id))
  .map((entry) => {
    // With the `cases-en` / `cases-ru` glob collections the id is already the
    // bare slug (e.g. "matchpoint"); no locale suffix to strip.
    const slug = entry.id;
    // Card title/subtitle come from frontmatter (see content schema); fall back
    // to the full title so a case is never renderless if the fields are unset.
    const title = entry.data.cardTitle ?? entry.data.title;

    return {
      title,
      subtitle: entry.data.cardSubtitle,
      href: locale === 'ru' ? `/ru/cases/${slug}` : `/cases/${slug}`,
      image: resolveImageAsset(entry.data.cover, 'ProjectsPage.astro'),
      imageAlt:
        locale === 'ru' ? `Обложка проекта ${title}` : `${title} project cover`,
    };
  });

const visualProjects: Record<Locale, ProjectItem[]> = {
  en: [
    {
      title: 'Filmaze',
      subtitle: 'Movie streaming service',
      href: '/cases/filmaze',
      image: filmazeCover,
      imageAlt: 'Filmaze mobile movie streaming service interface',
    },
    {
      title: 'Bergström',
      subtitle: 'Architecture studio website',
      href: '/cases/bergstrom',
      image: bergstromCover,
      imageAlt: 'Bergstrom architecture studio website on a laptop',
    },
  ],
  ru: [
    {
      title: 'Filmaze',
      subtitle: 'Онлайн-кинотеатр',
      href: '/ru/cases/filmaze',
      image: filmazeCover,
      imageAlt: 'Мобильный интерфейс онлайн-кинотеатра Filmaze',
    },
    {
      title: 'Bergström',
      subtitle: 'Сайт архитектурной студии',
      href: '/ru/cases/bergstrom',
      image: bergstromCover,
      imageAlt: 'Сайт архитектурной студии Bergstrom на ноутбуке',
    },
  ],
};

// Названия игр — это витринные названия из сторов, поэтому берутся как есть,
// с их регистром: у Pirate Treasures и Candy Valley в RU-сторе свои локальные
// названия, у Joe the Zombie локализации нет. Жанр «Match-3» тоже не переводим.
//
// Ссылки в сторе разведены по `hl`: посетитель RU-версии сайта должен попадать
// на русскую страницу Google Play, а не на английскую. У Joe the Zombie стора
// нет — там геймплейное видео, одно на обе локали.
const gameProjects: Record<Locale, ProjectItem[]> = {
  en: [
    {
      title: 'Joe the Zombie',
      subtitle: 'Mobile platformer',
      href: 'https://www.youtube.com/watch?v=FSP8YkMDfKQ',
      external: true,
      image: joeTheZombieCover,
      imageAlt: 'Joe the Zombie platformer level select screen',
    },
    {
      title: 'Pirate Treasures',
      subtitle: 'Match-3',
      href: 'https://play.google.com/store/apps/details?id=com.orangeapps.piratetreasure&hl=en',
      external: true,
      image: pirateTreasuresCover,
      imageAlt: 'Pirate Treasures tournament screen with a leaderboard',
    },
    {
      title: 'Candy Valley',
      subtitle: 'Match-3',
      href: 'https://play.google.com/store/apps/details?id=com.orangeapps.candyvalley&hl=en',
      external: true,
      image: candyValleyCover,
      imageAlt: 'Candy Valley match-3 game key art',
    },
  ],
  ru: [
    {
      title: 'Joe the Zombie',
      subtitle: 'Мобильный платформер',
      href: 'https://www.youtube.com/watch?v=FSP8YkMDfKQ',
      external: true,
      image: joeTheZombieCover,
      imageAlt: 'Экран выбора уровня в платформере Joe the Zombie',
    },
    {
      title: 'Сокровища Пиратов',
      subtitle: 'Match-3',
      href: 'https://play.google.com/store/apps/details?id=com.orangeapps.piratetreasure&hl=ru',
      external: true,
      image: pirateTreasuresCover,
      imageAlt: 'Экран турнира с таблицей лидеров в игре «Сокровища Пиратов»',
    },
    {
      title: 'Долина Сладостей',
      subtitle: 'Match-3',
      href: 'https://play.google.com/store/apps/details?id=com.orangeapps.candyvalley&hl=ru',
      external: true,
      image: candyValleyCover,
      imageAlt: 'Ключевой арт игры «Долина Сладостей» в жанре match-3',
    },
  ],
};

// Заголовок — имя плагина в Figma Community, поэтому не переводится; что он
// делает, объясняет подпись.
const petProjects: Record<Locale, ProjectItem[]> = {
  en: [
    {
      title: 'Radix Colors to Variables',
      subtitle: 'Color scale generator',
      href: 'https://www.figma.com/community/plugin/1636766593436362521',
      external: true,
      image: radixCover,
      imageAlt: 'Radix Colors to Variables plugin cover',
    },
  ],
  ru: [
    {
      title: 'Radix Colors to Variables',
      subtitle: 'Генератор цветовых растяжек',
      href: 'https://www.figma.com/community/plugin/1636766593436362521',
      external: true,
      image: radixCover,
      imageAlt: 'Обложка плагина Radix Colors to Variables',
    },
  ],
};

// Порядок секций определяет загрузку обложек (см. BlurImage ниже). Секции 0 и 1
// на типовом десктопе попадают выше сгиба — обе идут `eager`, иначе браузер
// отложит запрос до раскладки. `fetchpriority="high"` остаётся только у секции 0:
// кандидат в LCP здесь один, и размывать приоритет пятью картинками смысла нет.
// Секции 2+ ниже сгиба на любой разумной высоте окна — там `lazy`. Приоритеты
// считаются по индексу, поэтому смена порядка ниже их переносит сама.
const casesSection: ProjectSection = {
  title: content.casesTitle,
  items: caseItems,
};
const visualSection: ProjectSection = {
  title: content.visualTitle,
  items: visualProjects[locale],
};
const gamesSection: ProjectSection = {
  title: content.gamesTitle,
  items: gameProjects[locale],
};
const petSection: ProjectSection = {
  title: content.petTitle,
  items: petProjects[locale],
};

// Игры показываем только в игровом варианте: на общей главной они уводят
// внимание от продуктовых кейсов, ради которых её и открывают.
const sections: ProjectSection[] = isGames
  ? [gamesSection, casesSection, visualSection, petSection]
  : [casesSection, visualSection, petSection];
---

{/* Ставим html.js ДО отрисовки: с JS контент стартует скрытым и плавно
    проявляется; без JS — всё видно сразу. */}
<script is:inline>document.documentElement.classList.add('js');</script>

<main class="mx-auto w-full max-w-[72rem] px-5 py-16 sm:px-6 lg:px-8">
  {fallbackContentLocale && <TranslationNotice contentLocale={fallbackContentLocale} />}

  <div class="reveal mt-4 lg:flex lg:items-start lg:gap-16">
    <section class="lg:w-72 lg:shrink-0 lg:sticky lg:top-16">
      <BlurImage
        src={portrait}
        alt={content.portraitAlt}
        widths={[96, 112, 192, 224]}
        sizes="(min-width: 40rem) 112px, 96px"
        class="mb-5 h-24 w-24 rounded-lg border border-[var(--color-border)] sm:h-28 sm:w-28"
        eager
      />
      <p class="mb-3 text-sm text-[var(--color-text-muted)]">{content.role}</p>
      <h1 class="text-3xl font-semibold tracking-normal text-[var(--color-text)]">
        {content.name}
      </h1>
      <p class="mt-4 leading-7 text-[var(--color-text-muted)]">
        {content.intro}
      </p>
      <p class="mt-5 flex flex-wrap gap-x-2 gap-y-1 text-sm text-[var(--color-text-muted)]">
        {
          contactLinks.map((link, index) => (
            <>
              {index > 0 && <span aria-hidden="true">·</span>}
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noreferrer' : undefined}
                data-copy={link.copy}
                class="underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
              >
                {link.label}
              </a>
            </>
          ))
        }
      </p>
    </section>

    <div class="mt-12 lg:mt-0 lg:flex-1 space-y-14">
    {
      sections.map((section, sectionIndex) => (
        <section aria-labelledby={`section-${sectionIndex}`}>
          <h2
            id={`section-${sectionIndex}`}
            class="text-xl font-semibold tracking-normal text-[var(--color-text)]"
          >
            {section.title}
          </h2>
          <div class="mt-6 grid gap-8 sm:grid-cols-2">
            {section.items.map((item) => (
              <article aria-disabled={item.comingSoon ? 'true' : undefined}>
                {
                  item.comingSoon ? (
                    <div class="relative aspect-video w-full overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)]">
                      {
                        item.image ? (
                          <Image
                            src={item.image}
                            alt={item.imageAlt ?? item.title}
                            widths={[480, 720, 960]}
                            sizes="(min-width: 64rem) 350px, (min-width: 40rem) 50vw, calc(100vw - 2.5rem)"
                            format="webp"
                            class="h-full w-full scale-[1.22] object-cover opacity-65"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <div class="h-full w-full bg-black opacity-65"></div>
                        )
                      }
                      <div class="absolute inset-0 grid place-items-center bg-white/35">
                        <span class="rounded-full border border-white/60 bg-white/70 px-3 py-1 text-xs font-semibold text-[var(--color-text)] shadow-sm">
                          Coming Soon
                        </span>
                      </div>
                    </div>
                  ) : item.href ? (
                    <a
                      href={item.href}
                      target={item.external ? '_blank' : undefined}
                      rel={item.external ? 'noreferrer' : undefined}
                      aria-label={`${content.openLabel} ${item.title}`}
                      class="block overflow-hidden rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
                    >
                      {
                        item.image ? (
                          <BlurImage
                            src={item.image}
                            alt={item.imageAlt ?? item.title}
                            widths={[480, 720, 960]}
                            sizes="(min-width: 64rem) 350px, (min-width: 40rem) 50vw, calc(100vw - 2.5rem)"
                            class="aspect-video w-full rounded-lg border border-[var(--color-border)]"
                            eager={sectionIndex <= 1}
                            priority={sectionIndex === 0}
                          />
                        ) : (
                          <div class="aspect-video w-full rounded-lg bg-black"></div>
                        )
                      }
                    </a>
                  ) : (
                    <div class="aspect-video w-full rounded-lg bg-black"></div>
                  )
                }
                <h3
                  class:list={[
                    'mt-3 text-base font-medium',
                    item.comingSoon ? 'text-[var(--color-text-faint)]' : 'text-[var(--color-text)]',
                  ]}
                >
                  {
                    item.comingSoon ? (
                      item.title
                    ) : item.href ? (
                      <a
                        href={item.href}
                        target={item.external ? '_blank' : undefined}
                        rel={item.external ? 'noreferrer' : undefined}
                        class="underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
                      >
                        {item.title}
                      </a>
                    ) : (
                      item.title
                    )
                  }
                </h3>
                {
                  item.subtitle && (
                    <p class="mt-1 text-sm leading-6 text-[var(--color-text-muted)]">
                      {item.subtitle}
                    </p>
                  )
                }
              </article>
            ))}
          </div>
        </section>
      ))
    }
    </div>
  </div>
</main>

{/* Уведомление о копировании — всплывает над нажатой ссылкой (позицию ставит JS).
    Вне потока намеренно: подмена самого лейбла на «Copied — …» разъезжала бы
    строку контактов, там flex-wrap и втрое разная ширина текста.
    role="status" + aria-live делают его слышимым для скринридера: копирование
    само по себе визуально ничем не отзывается. Имя ссылки при этом не меняется. */}
<div class="copy-toast" data-copy-toast data-copied-label={content.copiedLabel} role="status" aria-live="polite">
  <Icon name="check" size={14} class="copy-toast__check" />
  <span data-copy-toast-text></span>
</div>

<script>
  // Клик по контакту копирует значение и НЕ переходит по ссылке. Переход тут
  // вредит: Arc на mailto открывает поверх страницы пустое окно с about:blank,
  // а t.me недоступен в РФ — в обоих случаях посетитель получает тупик, да ещё
  // и перекрывающий уведомление о копировании.
  //
  // Слушатель делегированный и висит на document: модуль выполняется один раз
  // за полную загрузку, а ClientRouter подменяет DOM — на закэшированный узел
  // тоста полагаться нельзя, ищем его в момент показа.
  const TOAST_MS = 2200;
  let toastTimer = 0;

  /** Зазор от края окна, чтобы чип у крайней ссылки не липнул к границе. */
  const EDGE = 12;
  /** Просвет между чипом и самой ссылкой. */
  const GAP = 8;

  const showToast = (value: string, anchor: HTMLElement) => {
    const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
    const text = toast?.querySelector<HTMLElement>('[data-copy-toast-text]');
    if (!toast || !text) return;

    const label = toast.dataset.copiedLabel || 'Copied';
    text.textContent = `${label} — ${value}`;

    // Меряем ДО показа: чип скрыт прозрачностью, а не display, поэтому размеры у
    // него уже настоящие — и позицию можно поставить до включения анимации.
    //
    // Обе координаты считаем в пикселях и НЕ используем процентные сдвиги по Y:
    // `translateY(-100%)` резолвится от высоты чипа на момент старта перехода, и
    // стоит тексту стать выше (перенос на узком экране) — просвет уезжает.
    const rect = anchor.getBoundingClientRect();
    const half = toast.offsetWidth / 2;
    const viewport = document.documentElement.clientWidth;
    const min = EDGE + half;
    const max = Math.max(min, viewport - EDGE - half);
    // Координаты вьюпортные (position: fixed): чип живёт секунды и переживает
    // их на месте, поэтому привязку к скроллу считать незачем — тем более что
    // колонка контактов на десктопе sticky и сама по себе не едет.
    toast.style.left = `${Math.min(Math.max(rect.left + rect.width / 2, min), max)}px`;

    // По умолчанию над ссылкой; если сверху не помещается (короткое окно,
    // прокрутка) — переносим под неё, чтобы чип не уехал за верхний край.
    const above = rect.top - toast.offsetHeight - GAP;
    const below = rect.bottom + GAP;
    toast.style.top = `${above >= EDGE ? above : below}px`;

    toast.classList.add('is-visible');
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.classList.remove('is-visible');
    }, TOAST_MS);
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>('a[data-copy]');
    const value = link?.dataset.copy;
    if (!value) return;

    // Модификаторы и не-левую кнопку не трогаем: cmd/ctrl-клик и средняя кнопка
    // — это явное «хочу открыть в новой вкладке», перехватывать их нельзя.
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    ) {
      return;
    }

    // Буфера может не быть в незащищённом контексте (http-превью). Тогда клик не
    // перехватываем вовсе — пусть отработает обычный переход, это лучше, чем
    // мёртвый клик, который ничего не делает и никуда не ведёт.
    if (!navigator.clipboard) return;

    event.preventDefault();
    navigator.clipboard.writeText(value).then(
      () => showToast(value, link),
      () => {},
    );
  });
</script>

<style>
  /* ── Уведомление о копировании ──
     left/top ставит JS в координатах вьюпорта, уже с учётом высоты чипа.
     Из transform остались только центрирование по X и короткий заезд по Y. */
  .copy-toast {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    max-width: min(22rem, calc(100vw - 1.5rem));
    border-radius: 0.5rem;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-subtle);
    padding: 0.375rem 0.625rem;
    color: var(--color-text);
    font-size: 0.8125rem;
    line-height: 1.4;
    white-space: nowrap;
    box-shadow: 0 10px 30px -8px rgb(0 0 0 / 25%);
    opacity: 0;
    /* Чип не должен ловить клики: он всплывает прямо над ссылкой, и перехват
       мешал бы повторному нажатию. Оживает только вместе с классом. */
    pointer-events: none;
    transform: translateX(-50%) translateY(0.25rem);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }
  .copy-toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  /* Галочка — единственное цветное пятно в чипе. `--color-accent` тут не
     годится: он резолвится в цвет обычного текста и ничего не отличает. */
  .copy-toast :global(.copy-toast__check) {
    flex: none;
    color: var(--color-success-4);
  }
  @media (prefers-reduced-motion: reduce) {
    .copy-toast {
      transition-duration: 0.001ms;
    }
  }
</style>

<style>
  /* Мягкий fade-in контента на первой загрузке — страница «проявляется», а не
     возникает мгновенно белый→текст. CSS-анимация стартует сама при отрисовке
     (не нужен JS-триггер, нет риска «залипшего» скрытого текста), `both` держит
     opacity:0 до старта → без вспышки. Без JS (нет html.js) — контент виден сразу. */
  @keyframes contentIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  :global(html.js) .reveal {
    animation: contentIn 0.5s ease both;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .reveal {
      animation: none;
    }
  }
</style>
